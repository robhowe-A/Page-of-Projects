@page "/database/spaceflight-news-app/sfan-db0"

@using Microsoft.AspNetCore.Components.Web
@using ProjectsPage.Components.Secondary
@using ProjectsPage.Domain
@using ProjectsPage.Infrastructure
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer

@namespace ProjectsPage.Pages.Database

<PageTitle>Database | SpaceFlight News App</PageTitle>
<article class="page-table">
    <DatabaseNav/>
    <div class="page-viewbox">
        <SpaceflightArticleTable Articles="@_articlesDbContext.Article.Where(x => x.ArticleNum >= 1).ToList()"
                              H3ElemText="Articles Data"/>
    </div>
    <div class="page-viewbox">
        <SpaceflightApodTable Apods="@_articlesDbContext.APOD.Where(x => x.Id >= 1).ToList()"
                              H3ElemText="APOD Data"/>
    </div>
</article>
@code {
    private SpaceflightDbContext _articlesDbContext = EntityModels.CreateArticlesDbContext();

    public static List<SpaceflightArticle> FiveArticles()
    {
        return EntityModels.CreateArticlesDbContext()
                           .Article
                           .OrderByDescending(a => a.Date)
                           .Take(5).ToList();
    }

    public static List<SpaceflightApod> FiveApods()
    {
        return EntityModels.CreateArticlesDbContext()
                           .APOD
                           .OrderByDescending(a => a.Date)
                           .Take(5).ToList();
    }
}