@page "/database/projects-hub/heartbeats"
@using Microsoft.AspNetCore.Components.Web
@using ProjectsPage.Components.Primary
@using ProjectsPage.Components.Secondary
@using ProjectsPage.Domain
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inherits ProjectsPage.Components.Pages.HeartbeatsTableBase
@rendermode InteractiveServer

@namespace ProjectsPage.Pages.Database

<PageTitle>Heartbeats | roberthowell.dev</PageTitle>
<article id="Heartbeats-Page" class="page-table">
    <DatabaseNav/>
    <div class="page-viewbox">
        <HeartbeatFilter OnFilterFind="@OnHeartbeatDataRowsFilterFindComplete"
                         H3ElemText="Heartbeat Requests"/>
        <HeartbeatTable Heartbeats="@(_heartbeatRows is null ? HeartbeatsAll : _heartbeatRows.ToList())"
                        GetLoopDataSet="@GetLoopDataSet"
                        RecordComparison="@HeartbeatComparer"/>
    </div>
</article>
@code {
    private HeartbeatData[]? _heartbeatRows = [];
    private Task OnHeartbeatDataRowsFilterFindComplete(List<HeartbeatData> rows)
    {
        _heartbeatRows = rows.ToArray();
        return Task.CompletedTask;
    }
}