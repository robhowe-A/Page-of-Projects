@page "/database/randomwebbits"

@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using ProjectsPage.Components.Primary
@using ProjectsPage.Components.Secondary
@using ProjectsPage.Domain
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer

@namespace ProjectsPage.Pages.Database

<PageTitle>Database | Random Web Bits</PageTitle>
<article class="page-table">
    <DatabaseNav/>
    <div class="page-viewbox">
        <AccessRecordFilter OnFilterFind="@OnAccessRecordFilterFindComplete"
                            H3ElemText="Access Record"/>
        <RwbAccessRecordTable AllAccessRecord="@_arRows.ToList()"/>
    </div>
    <div class="page-viewbox">
        <RwbAnonymousUserTable AllAnonymousUser="@_auRows.ToList()"
                               H3ElemText="Anonymous User"/>
    </div>
    <div class="page-viewbox">
        <UserAgentFilter OnFilterFind="@OnUserAgentFilterFindComplete"
                         H3ElemText="User Agent"/>
        <RwbUserAgentTable AllUserAgent="@_uaRows.ToList()"/>
    </div>
    </article>
@code {

    private RwbAccessRecord[] _arRows = [];
    private RwbUserAgent[] _uaRows = [];
    private RwbAnonymousUser[] _auRows = [];

    private Task OnAccessRecordFilterFindComplete(List<RwbAccessRecord> rows)
    {
        _arRows = rows.ToArray();
        return Task.CompletedTask;
    }

    private Task OnUserAgentFilterFindComplete(List<RwbUserAgent> rows)
    {
        _uaRows = rows.ToArray();
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        await using var dbContext = EntityModels.CreateRwbDbContext();

        _arRows = await dbContext.access_record.AsNoTracking()
                                .OrderBy(k => k.AnonymousUserId)
                                .ThenBy(k => k.LastAccessed)
                                .Where(x => x.AnonymousUserId >= 0).ToArrayAsync();
        _uaRows = await dbContext.user_agent.AsNoTracking()
                                .Where(x => x.AgentId >= 1)
                                .ToArrayAsync();
        _auRows = await dbContext.anonymous_user.AsNoTracking()
                                 .Where(x => x.AnonymousUserId >= 1)
                                 .ToArrayAsync();

    }
}
