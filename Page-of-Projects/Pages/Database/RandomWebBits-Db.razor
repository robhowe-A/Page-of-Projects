@page "/database/randomwebbits/rwb-db0"

@using Microsoft.AspNetCore.Components.Web
@using ProjectsPage.Components.Secondary
@using ProjectsPage.Domain
@using ProjectsPage.Infrastructure
@using ProjectsPage.Presentation.Primary
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer

@namespace ProjectsPage.Pages.Database

<PageTitle>Database | Random Web Bits</PageTitle>
<article class="page-table">
    <DatabaseNav/>
    <div class="page-viewbox">
        <AccessRecordFilter OnFilterFind="@OnAccessRecordFilterFindComplete"
                            H3ElemText="Access Record"/>
        <RwbAccessRecordTable AllAccessRecord="@(ARRows == null ? _rwbDbContext.access_record.OrderBy(k => k.AnonymousUserId).ThenBy(k => k.LastAccessed).Where(x => x.AnonymousUserId >= 0).ToList() : ARRows.ToList())"/>
    </div>
    <div class="page-viewbox">
        <RwbAnonymousUserTable AllAnonymousUser="@_rwbDbContext.anonymous_user.Where(x => x.AnonymousUserId >= 1).ToList()"
                               H3ElemText="Anonymous User"/>
    </div>
    <div class="page-viewbox">
        <UserAgentFilter OnFilterFind="@OnUserAgentFilterFindComplete"
                            H3ElemText="User Agent"/>
        <RwbUserAgentTable AllUserAgent="@(UARows == null ? _rwbDbContext.user_agent.Where(x => x.AgentId >= 1).ToList() : UARows.ToList())"/>
    </div>
    </article>
@code {
    private RwbDbContext _rwbDbContext = EntityModels.CreateRwbDbContext();
    
    private RwbAccessRecord[]? ARRows = null;
    private RwbUserAgent[]? UARows = null;

    private async Task OnAccessRecordFilterFindComplete(List<RwbAccessRecord> rows)
    {
        ARRows = rows.ToArray();
    }

    private async Task OnUserAgentFilterFindComplete(List<RwbUserAgent> rows)
    {
        UARows = rows.ToArray();
    }

}
