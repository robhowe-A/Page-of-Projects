@page "/heartbeat-failures"
@using Microsoft.AspNetCore.Components.Web
@using ProjectsPage.Components.Secondary
@using ProjectsPage.Domain
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inherits HeartbeatsTableBase
@rendermode InteractiveServer

@namespace ProjectsPage.Components.Pages

<PageTitle>Heartbeats-Failures | roberthowell.dev</PageTitle>
<article id="Heartbeat-Failures-Page" class="page-table">
    <DatabaseNav/>
    <div class="page-viewbox folding">
        <HeartbeatTable Heartbeats="@(
                                Heartbeats.ConvertAll(i => new HeartbeatData
                                                           {
                                                                   Id = i.Id,
                                                                   Timestamp = i.RecordTimestamp,
                                                                   Agent = i.Agent,
                                                                   Project = i.ProjectName,
                                                                   Domain = i.Domain,
                                                                   RelativeUrl = i.UrlRel,
                                                                   ResponseCode = i.ResponseStatus
                                                           }))"
                    H3ElemText="Heartbeat Failures"
                    GetLoopDataSet="@GetLoopDataSet"
                    RecordComparison="@HeartbeatComparer"/>
    </div>
</article>
