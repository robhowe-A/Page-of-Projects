@page "/database"
@using ProjectsPage.Components.Pages
@using ProjectsPage.Components.Secondary
@using ProjectsPage.Domain
@using ProjectsPage.Pages.Websites
@using ProjectsPage.Presentation.Aside

@code {
    public static Queue<DatabaseTableLink> PageLinks = CreateNewLinksStack();

    private static Queue<DatabaseTableLink> CreateNewLinksStack()
    {
        Queue<DatabaseTableLink> links = new();
        links.Enqueue(new DatabaseTableLink
                      {
                              Href = "/heartbeat-all",
                              Title = "Heartbeat All",
                              TextContent = "Heartbeat All | roberthowell.dev"
                      });
        links.Enqueue(new DatabaseTableLink
                      {
                              Href = "/heartbeat-failures",
                              Title = "Heartbeat Failures",
                              TextContent = "Heartbeat Failures | roberthowell.dev"
                      });
        links.Enqueue(new DatabaseTableLink
                      {
                              Href = "/websites/spaceflight-news-app/database",
                              Title = "Database | SpaceFlight News App",
                              TextContent = "SpaceFlight News App"
                      });
        links.Enqueue(new DatabaseTableLink
                      {
                              Href = "/websites/randomwebbits/database",
                              Title = "Database | Random Web Bits",
                              TextContent = "Random Web Bits - Accessed By"
                      });
        links.Enqueue(new DatabaseTableLink
                      {
                              Href = "/websites/randomwebbits/database2",
                              Title = "Database2 | Random Web Bits",
                              TextContent = "Random Web Bits - Anonymous User"
                      });
        links.Enqueue(new DatabaseTableLink
                      {
                              Href = "/websites/randomwebbits/database3",
                              Title = "Database3 | Random Web Bits",
                              TextContent = "Random Web Bits - User Agent"
                      });
        return links;
    }

    private Queue<DatabaseTableLink> _links = CreateNewLinksStack();

}

<article id="Status-Page" class="database-card-grid">
    <div>
        <div>
            <AppNavLink Link="@_links.Dequeue()"/>
            <CopyJsonToClipboard
                Items="@HeartbeatsTableBase.FiveHeartbeats()"/>
        </div>
        <table>
            <caption>HeartBeats.All</caption>
            <RowGenerator Items="@HeartbeatsTableBase.FiveHeartbeats()">
                <HeaderTemplate>
                    <tr>
                        <td>Id</td>
                        <td>TimeStamp</td>
                        <td>Domain</td>
                        <td>ResponseCode</td>
                    </tr>
                </HeaderTemplate>
                <RowTemplate Context="item">
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Timestamp</td>
                        <td>@item.Domain</td>
                        <td>@item.ResponseCode</td>
                    </tr>
                </RowTemplate>
            </RowGenerator>
        </table>
    </div>
    <div>
        <div>
            <AppNavLink Link="@_links.Dequeue()"/>
            <CopyJsonToClipboard
                Items="@HeartbeatsTableBase.FiveHeartbeatsFailures()"/>
        </div>
        <table>
            <caption>HeartBeats.Failures</caption>
            <RowGenerator Items="@HeartbeatsTableBase.FiveHeartbeatsFailures()">
                <HeaderTemplate>
                    <tr>
                        <td>Id</td>
                        <td>TimeStamp</td>
                        <td>Domain</td>
                        <td>ResponseCode</td>
                    </tr>
                </HeaderTemplate>
                <RowTemplate Context="item">
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Timestamp</td>
                        <td>@item.Domain</td>
                        <td>@item.ResponseCode</td>
                    </tr>
                </RowTemplate>
            </RowGenerator>
        </table>
    </div>
    <div>
        <div>
            <AppNavLink Link="@_links.Peek()"/>
            <CopyJsonToClipboard
                Items="@SNAPI_Db.FiveArticles()"/>
        </div>
        <table>
            <caption>SpaceFlightNewsApp.Article</caption>
            <RowGenerator Items="@SNAPI_Db.FiveArticles()">
                <HeaderTemplate>
                    <tr>
                        <td>ArticleNum</td>
                        <td>Date</td>
                        <td>Featured</td>
                        <td>NewsSite</td>
                    </tr>
                </HeaderTemplate>
                <RowTemplate Context="item">
                    <tr>
                        <td>@item.ArticleNum</td>
                        <td>@item.Date</td>
                        <td>@item.Featured</td>
                        <td>@item.NewsSite</td>
                    </tr>
                </RowTemplate>
            </RowGenerator>
        </table>
    </div>
    <div>
        <div>
            <AppNavLink Link="@_links.Dequeue()"/>
            <CopyJsonToClipboard
                Items="@SNAPI_Db.FiveApods()"/>
        </div>
        <table>
            <caption>SpaceFlightNewsApp.Apod</caption>
            <RowGenerator Items="@SNAPI_Db.FiveApods()">
