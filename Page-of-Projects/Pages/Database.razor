        </div>
        <table>
            <caption>RandomWebBits.AccessedBy</caption>
            <RowGenerator Items="@RandomWebBitsBase.FiveAccessedBy()">
                <HeaderTemplate>
                    <tr>
                        <td>Anonymous User Id</td>
                        <td>Uri</td>
                        <td>Last Accessed</td>
                    </tr>
                </HeaderTemplate>
                <RowTemplate Context="item">
                    <tr>
                        <td>@item.AnonymousUserId</td>
