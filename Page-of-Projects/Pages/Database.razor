                    <tr>
                        <td>Date</td>
                        <td>Media</td>
                        <td>Title</td>
                    </tr>
                </HeaderTemplate>
                <RowTemplate Context="item">
                    <tr>
                        <td>@item.Date</td>
                        <td>@item.Media</td>
                        <td>@item.ApodTitle</td>
                    </tr>
                </RowTemplate>
            </RowGenerator>
        </table>
    </div>
    <div>
        <div>
            <AppNavLink Link="@_links.Dequeue()"/>
