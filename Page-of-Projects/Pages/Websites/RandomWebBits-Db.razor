@page "/websites/randomwebbits/database"

@using Microsoft.AspNetCore.Components.Web
@using ProjectsPage.Components.Secondary
@using ProjectsPage.Domain
@using ProjectsPage.Infrastructure
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer

<PageTitle>Database | Random Web Bits</PageTitle>
<article class="page-table">
    <DatabaseNav/>
    <div>
        <h2>Accessed By</h2>
        <RwbAccessRecordTable AllAccessRecord="@_rwbDbContext.access_record.OrderBy(k=>k.AnonymousUserId).ThenBy(k=>k.LastAccessed).Where(x => x.AnonymousUserId >= 1).ToList()"/>

    </div>
</article>
@code {
    private RwbDbContext _rwbDbContext = EntityModels.CreateRwbDbContext();
}
