@page "/jit"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@inject ITempDataDictionaryFactory TempDataFactory
@namespace ProjectsPage.Components.Primary

<PageTitle>Jit</PageTitle>

<article id="Jit">
    <h3>Jit Access Requests</h3>
    <div>
        <p>
            This page provides granting access to private GitHub repositories, each given a tile below. Use a valid GitHub username in the form and submit; approval is granted automatically. After the processing completes, check your GitHub inbox for the repository invitation.
        </p>
        <h2>Private Repository Access Request</h2>
        <div class="access-request-tiles">
        @foreach (var repo in jitAccessRepositories)
        {
            var data = _repositories.FirstOrDefault(r => r[0] == repo.Key);
            <div class="access-request-tile">
                <ul>
                    <li><a href="@data?[3]"><span>@repo.Key.ToUpper()</span></a></li>
                    <li>Name: <span>@data?[0]</span></li>
                    <li>Parent: <span>@data?[2]</span></li>
                </ul>
                @if (!string.IsNullOrEmpty(_jitResult))
                {
                <p>Result: @_jitResult</p>
                }
                @if ( _jitAccessRepositories.ContainsKey(repo.Value)
                      && !string.IsNullOrEmpty(_jitAccessRepositories[repo.Value]))
                {
                    <p>StatusCode: @_jitAccessRepositories[repo.Value]</p>
                }
                else
                {
                    <button type="button"
                            commandfor="view-jit-access-@(repo.Value)"
                            command="show-modal">Request Access</button>
                }
            </div>
        }
        </div>
    </div>

</article>
@foreach (var repo in jitAccessRepositories)
{
    <dialog id="view-jit-access-@(repo.Value)">
        <div class="wrapper">
            <h2>Access request form: <span>@repo.Key</span></h2>
            <p>Submitting this form requests the provided username access to @repo.Key repository.</p>
            <form method="post" name="jit-form"
                  action="/api/jit"
                  autocomplete="off">
                <AntiforgeryToken/>
                <label>Username:
                    <input name="username" type="text" autofocus
                           maxlength="39"
                           validationmessage="Username is too long (maximum is 39 characters)." required/></label>
                <input type="hidden" name="repositoryName" value="@repo.Key"/>
                <input type="hidden" name="repositoryNumber" value="@repo.Value"/>
                <button type="submit">Submit</button>
            </form>
            <button
                commandfor="view-jit-access-@(repo.Value)"
                command="request-close">Close</button>
        </div>
    </dialog>
}

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? _jitResult;

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if (firstRender)
        {
            TempData?.Clear();
        }
    }

    private ITempDataDictionary? TempData { get; set; }

    protected override void OnInitialized()
    {
        if (HttpContext == null) return;

        TempData = TempDataFactory.GetTempData(HttpContext);

        foreach (var (temps,value) in TempData)
        {
            if (string.Equals(temps, "JitResult") & !temps.Contains("-"))
            {
                _jitResult = (string?)value;
                continue;
            }
            var tempNumber = Convert.ToInt16(temps.Split("-")[1]);
            _jitAccessRepositories[tempNumber] = value as string ?? "Error: Repository name missing";
        }

        int repositoryCount = 0;

        foreach (var repository in _repositories)
        {
            jitAccessRepositories.TryAdd(repository[0], repositoryCount);
            repositoryCount++;

        // Force clear the temp data dictionary
        if(TempData.Count > 0 & TempData.ContainsKey($"JitResult-{repositoryCount}"))
            TempData.Remove($"JitResult-{repositoryCount}"); //Any repository controller return
        if(TempData.Count > 0 & TempData.ContainsKey("JitResult"))
            TempData.Remove("JitResult"); //No repository controller return
        TempData.Save();
        }
    }

    private Dictionary<string, int> jitAccessRepositories = new();
    private Dictionary<int, string> _jitAccessRepositories = new();

    private List<List<string>> _repositories = [
            ["RWB-TypeScript", "/websites/randomwebbits", "Random Web Bits", "https://github.com/robhowe-A/RWB-TypeScript"],
            ["Sln-SpaceFlight_News_App", "/websites/spaceflight-news-app", "SpaceFlight News App", "https://github.com/robhowe-A/Sln-SpaceFlight_News_App"],
            ["Sln-QuizzesApp", "/websites/quizzes-app", "Quizzes App", "https://github.com/robhowe-A/Sln-QuizzesApp"],
            ["Sln-Page-Of-Projects", "/", "Projects Hub", "https://github.com/robhowe-A/Sln-Page-Of-Projects"],
            ["easybank-website", "/demos/easybank", " Easybank", "https://github.com/robhowe-A/easybank-website"],
            ["Creative-Single-Page", "/demos/creativesinglepage", "Creative Single Page", "https://github.com/robhowe-A/Creative-Single-Page"],
            ["AgileStock", "/websites/agilestock-web", "AgileStock Web", "https://github.com/robhowe-A/AgileStock"],
            ["Password-Generator", "/demos/passwordgenerator", " Password Generator", "https://github.com/robhowe-A/Password-Generator"]
    ];
}
