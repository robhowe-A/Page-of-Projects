@using ProjectsPage.Components.Secondary
@rendermode @(new InteractiveServerRenderMode(prerender:false))

@namespace ProjectsPage.Components.Primary

<div>
    <div class="page-viewbox @(!_isAccessRecordFilterSubmitting ? "" : "isLoading")">
        <AccessRecordFilter OnFilterFind="@OnAccessRecordFilterFindComplete"
                            OnSubmittingChanged="@OnAccessRecordFilterSubmittingChanged"
                            H3ElemText="Access Record"/>
        @if (_isArPendingData)
        {
            <p>Loading data...</p>
        }
        else if (_isAccessRecordFilterSubmitting)
        {
            <p>Retrieving data...</p>
        }
        else
        {
            <RwbAccessRecordTable AllAccessRecord="@_arRows.ToList()"/>
        }
    </div>

    <div class="page-viewbox">
        @if (_isAuPendingData)
        {
            <p>Loading data...</p>
        }
        else
        {
            <RwbAnonymousUserTable AllAnonymousUser="@_auRows.ToList()"
                                   H3ElemText="Anonymous User"/>
        }
    </div>

    <div class="page-viewbox @(!_isUserAgentFilterSubmitting ? "" : "isLoading")">
        <UserAgentFilter OnFilterFind="@OnUserAgentFilterFindComplete"
                         OnSubmittingChanged="@OnUserAgentFilterSubmittingChanged"
                         H3ElemText="User Agent"/>
        @if (_isUaPendingData)
        {
            <p>Loading data...</p>
        }
        else if (_isUserAgentFilterSubmitting)
        {
            <p>Retrieving data...</p>
        }
        else
        {
            <RwbUserAgentTable AllUserAgent="@_uaRows.ToList()"/>
        }
    </div>
</div>