@using ProjectsPage.Components.Secondary
@rendermode InteractiveServer

@namespace ProjectsPage.Components.Primary

<div>
    <div class="page-viewbox @(!_isAccessRecordFilterSubmitting ? "" : "isLoading")">
        <div>
            <AccessRecordFilter OnFilterFind="@OnAccessRecordFilterFindComplete"
                                OnSubmittingChanged="@OnAccessRecordFilterSubmittingChanged"
                                QueryLimit="@QueryLimit"
                                H3ElemText="Access Record"/>
            <p class="page-viewbox-error">@LimitWarning</p>
        </div>
        <div class="page-viewbox-content
        @(_isArPendingData.HasValue && !_isArPendingData.Value & !_isAccessRecordFilterSubmitting ? "dataReady" : "")
        @(_isArPendingData.HasValue && _isArPendingData.Value ? "isLoading" : "")
        @(_isAccessRecordFilterSubmitting ? "isSubmitting" : "")">
            @if (_isArPendingData.HasValue && _isArPendingData.Value)
            {
                <p>Loading data...</p>
            }
            @if (_isAccessRecordFilterSubmitting)
            {
                <p>Retrieving data...</p>
            }
            else
            {
                <RwbAccessRecordTable AccessRecords="@_arRows.ToList()"/>
            }
        </div>
    </div>

    <div class="page-viewbox">
        <div class="page-viewbox-content
        @(_isAuPendingData.HasValue && !_isAuPendingData.Value ? "dataReady" : "")
        @(_isAuPendingData.HasValue && _isAuPendingData.Value ? "isLoading" : "")">
            @if (_isAuPendingData.HasValue && _isAuPendingData.Value)
            {
                <p>Loading data...</p>
            }
            else
            {
                <RwbAnonymousUserTable AnonymousUsers="@_auRows.ToList()"
                                       H3ElemText="Anonymous User"/>
            }
        </div>
    </div>

    <div class="page-viewbox">
        <div>
            <UserAgentFilter OnFilterFind="@OnUserAgentFilterFindComplete"
                             OnSubmittingChanged="@OnUserAgentFilterSubmittingChanged"
                             QueryLimit="@UserAgentQueryLimit"
                             H3ElemText="User Agent"/>
            <p class="page-viewbox-error">@UserAgentLimitWarning</p>
        </div>
        <div class="page-viewbox-content
        @(_isUaPendingData.HasValue && !_isUaPendingData.Value & !_isUserAgentFilterSubmitting ? "dataReady" : "")
        @(_isUaPendingData.HasValue && _isUaPendingData.Value ? "isLoading" : "")
        @(_isUserAgentFilterSubmitting ? "isSubmitting" : "")">
            @if (_isUaPendingData.HasValue && _isUaPendingData.Value)
            {
                <p>Loading data...</p>
            }
            @if (_isUserAgentFilterSubmitting)
            {
                <p>Retrieving data...</p>
            }
            else
            {
                <RwbUserAgentTable UserAgents="@_uaRows.ToList()"/>
            }
        </div>
    </div>
</div>