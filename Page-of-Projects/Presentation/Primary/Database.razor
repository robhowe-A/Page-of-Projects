@using ProjectsPage.Components.Pages
@using ProjectsPage.Components.Secondary
@using ProjectsPage.Domain
@using ProjectsPage.Pages.Websites
@using ProjectsPage.Presentation.Aside

@namespace ProjectsPage.Presentation.Primary

<section class="database-card-grid">
    @foreach(var gridItem in Items){
        
        <div>
            <div>
                <div>
                    <AppNavLink Link="@_links.Dequeue()"/>
                </div>
                <div class="data-egress">
                    <CopyJsonToClipboard
                        Items="@gridItem.OverviewItems"/>
                    <CsvExportHelper Items="@gridItem.OverviewItems"
                                     FileName="@gridItem.OverviewItemsCsvFileName"
                                     ButtonText="Download CSV"/>
                </div>
            </div>
            <table>
                <caption>@gridItem.CaptionText</caption>
                <RowGenerator Items="@gridItem.OverviewItems">
                    <HeaderTemplate>
                        @gridItem.HeaderTemplateStr
                    </HeaderTemplate>
                    <RowTemplate Context="item">
                        @gridItem.RowTemplateBuildStr.Invoke(item)
                    </RowTemplate>
                </RowGenerator>
            </table>
        </div>
    }
</section>
