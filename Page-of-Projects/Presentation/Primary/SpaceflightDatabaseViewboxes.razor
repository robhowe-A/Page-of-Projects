@using ProjectsPage.Components.Secondary
@rendermode InteractiveServer

@namespace ProjectsPage.Components.Primary

<div>
    <div class="page-viewbox @(!_isArticleFilterSubmitting ? "" : "isLoading")">
        <div>
            <SpaceflightArticleFilter OnFilterFind="@OnArticleFilterFindComplete"
                                      OnSubmittingChanged="@OnArticleFilterSubmittingChanged"
                                      QueryLimit="@QueryLimit"
                                      H3ElemText="Articles Data"/>
            <p class="page-viewbox-error">@LimitWarning</p>
        </div>
        <div class="page-viewbox-content
        @(_isArticlePendingData.HasValue && !_isArticlePendingData.Value & !_isArticleFilterSubmitting ? "dataReady" : "")
        @(_isArticlePendingData.HasValue && _isArticlePendingData.Value ? "isLoading" : "")
        @(_isArticleFilterSubmitting ? "isSubmitting" : "")">
            @if (_isArticlePendingData.HasValue && _isArticlePendingData.Value)
            {
                <p>Loading data...</p>
            }
            else if (_isArticleFilterSubmitting)
            {
                <p>Retrieving data...</p>
            }
            else
            {
                <SpaceflightArticleTable Articles="@_articles.ToList()"/>
            }
        </div>
    </div>

    <div class="page-viewbox @(!_isApodFilterSubmitting ? "" : "isLoading")">
        <div>
            <SnapiApodFilter OnFilterFind="@OnApodFilterFindComplete"
                             OnSubmittingChanged="@OnApodFilterSubmittingChanged"
                             QueryLimit="@QueryLimit"
                             H3ElemText="APOD Data"/>
            <p class="page-viewbox-error">@ApodLimitWarning</p>
        </div>
        <div class="page-viewbox-content
        @(_isApodPendingData.HasValue && !_isApodPendingData.Value & !_isApodFilterSubmitting ? "dataReady" : "")
        @(_isApodPendingData.HasValue && _isApodPendingData.Value ? "isLoading" : "")
        @(_isApodFilterSubmitting ? "isSubmitting" : "")">
            @if (_isApodPendingData.HasValue && _isApodPendingData.Value)
            {
                <p>Loading data...</p>
            }
            else if (_isApodFilterSubmitting)
            {
                <p>Retrieving data...</p>
            }
            else
            {
                <SpaceflightApodTable Apods="@_apods.ToList()"/>
            }
        </div>
    </div>
</div>