@using System.Collections.Immutable
@using ProjectsPage.Domain

@namespace ProjectsPage.Components.Secondary
@inherits FoldingDataTable

<div class="table-viewbox-content">
    <div>
        @if (Heartbeats.Count() <= 200)
        {
            @if (IsFoldingView)
            {
                <button @onclick="ToggleViewSummary">Table View</button>
            }
            else
            {
                <button @onclick="ToggleViewSummary">Daily View</button>
            }
        }
    </div>

    <div class="table-viewbox">
        <h2>@H3ElemText</h2>
        <div class="data-viewbox @(IsFoldingView ? "folding" : "")">
            <table>
            @if (IsFoldingView)
            {
                var dateCursor = DateTime.Now;
                var allItems = new SortedSet<HeartbeatData>(Heartbeats.ToImmutableList(), RecordComparison);
                const string dateMeasure = "YEAR";
                const string dateMeasureMonth = "MONTH";
                const string dateMeasureDay = "DAY";

                <tbody>
                @do
                {
                    var (yearSelection, yearHeartbeats)
                            = GetLoopDataSet(dateMeasure, allItems, dateCursor, RecordComparison);

                    var year = dateCursor.Year;
                    var yearKey = $"{dateCursor.Year}";

                    if (yearHeartbeats.Count > 0)
                    {
                        <tr>
                            <td>
                                <button @onclick="() => Toggle(yearKey)">@(IsExpanded(yearKey) ? "−" : "+")</button>
                                @dateCursor.Year
                            </td>
                            <td>-</td>
                            <td>-</td>
                            <td>-</td>
                            <td>-</td>
                            <td>-</td>
                            <td>-</td>
                        </tr>
                    }

                    do
                    {
                        var (monthSelection, monthHeartbeats)
                                = GetLoopDataSet(dateMeasureMonth, yearHeartbeats, dateCursor, RecordComparison);

                        var month = dateCursor.Month;
                        var monthKey = $"{dateCursor.Year}-{dateCursor.Month}";

                        if (monthHeartbeats.Count > 0 & IsExpanded(yearKey))
                        {
                            <tr>
                                <td>
                                    <button @onclick="() => Toggle(monthKey)">@(IsExpanded(monthKey) ? "−" : "+")</button>
                                    @dateCursor.ToString("MMMM")
                                </td>
                                <td>-</td>
                                <td>-</td>
                                <td>-</td>
                                <td>-</td>
                                <td>-</td>
                                <td>-</td>
                            </tr>
                        }

                        //while (monthHeartbeats.Count > 0)
                        while (dateCursor.Month == month)
                        {
                            var (daySelection, dayHeartbeats)
                                    = GetLoopDataSet(dateMeasureDay, monthHeartbeats, dateCursor, RecordComparison);

                            var dayKey = $"{dateCursor.Year}-{dateCursor.Month}-{dateCursor.Day}";

                            if (dayHeartbeats.Count > 0 & IsExpanded(yearKey) && IsExpanded(monthKey))
                            {
                                if (IsExpanded(dayKey) == false)
                                {
                                    <tr>
                                        <td>
                                            <button @onclick="() => Toggle(dayKey)">@(IsExpanded(dayKey) ? "−" : "+")</button>
                                            @string.Format("{0,12:d, ddd}", dateCursor)
                                        </td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td>-</td>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <td>
                                            <button @onclick="() => Toggle(dayKey)">@(IsExpanded(dayKey) ? "−" : "+")</button>
                                            @string.Format("{0,12:d, ddd}", dateCursor)
                                        </td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td>-</td>
                                    </tr>
                                }
                            }

                            if (IsExpanded(yearKey) && IsExpanded(monthKey) && IsExpanded(dayKey))
                            {
                                <RowGenerator Items="@SortVisibleHeartbeats(dayHeartbeats)">
                                    <HeaderTemplate>
                                        <thead>
                                            <tr>
                                                <th @onclick="@(() => SortHeartbeatTableById(x => x.Id))">Id</th>
                                                <th @onclick="@(() => SortHeartbeatTableByTimestamp(x => x.Timestamp))">Timestamp</th>
                                                <th @onclick="@(() => SortHeartbeatTableByAgent(x => x.Agent))">Agent</th>
                                                <th @onclick="@(() => SortHeartbeatTableByProject(x => x.Project))">Project</th>
                                                <th @onclick="@(() => SortHeartbeatTableByDomain(x => x.RelativeUrl))">Domain</th>
                                                <th @onclick="@(() => SortHeartbeatTableByRelativeUrl(x => x.RelativeUrl))">Relative Url</th>
                                                <th @onclick="@(() => SortHeartbeatTableByResponseCode(x => x.ResponseCode))">Response Code</th>
                                            </tr>
                                        </thead>
                                    </HeaderTemplate>
                                    <RowTemplate Context="item">
                                        <tr class="row-pattern">
                                            <td><span>@item.Id</span></td>
                                            <td><span>@item.Timestamp</span></td>
                                            <td><span>@item.Agent</span></td>
                                            <td><span>@item.Project</span></td>
                                            <td><span>@item.Domain</span></td>
                                            <td><span>@item.RelativeUrl</span></td>
                                            <td><span>@item.ResponseCode</span></td>
                                        </tr>
                                    </RowTemplate>
                                </RowGenerator>
                            }

                            monthHeartbeats.RemoveWhere(daySelection);
                            dateCursor = dateCursor.AddDays(-1);
                        }

                        ;

                        yearHeartbeats.RemoveWhere(monthSelection);
                    } while (dateCursor.Year == year);

                    allItems.RemoveWhere(yearSelection);
                } while (allItems.Count > 0);
                </tbody>
            }
            else
            {
                <RowGenerator Items="@Heartbeats">
                    <HeaderTemplate>
                        <thead>
                            <tr>
                                <th @onclick="@(() => SortHeartbeatTableById(x => x.Id))">Id</th>
                                <th @onclick="@(() => SortHeartbeatTableByTimestamp(x => x.Timestamp))">Timestamp</th>
                                <th @onclick="@(() => SortHeartbeatTableByAgent(x => x.Agent))">Agent</th>
                                <th @onclick="@(() => SortHeartbeatTableByProject(x => x.Project))">Project</th>
                                <th @onclick="@(() => SortHeartbeatTableByDomain(x => x.RelativeUrl))">Domain</th>
                                <th @onclick="@(() => SortHeartbeatTableByRelativeUrl(x => x.RelativeUrl))">Relative Url</th>
                                <th @onclick="@(() => SortHeartbeatTableByResponseCode(x => x.ResponseCode))">Response Code</th>
                            </tr>
                        </thead>
                    </HeaderTemplate>
                    <RowTemplate Context="item">
                        <tr class="row-pattern">
                            <td><span>@item.Id</span></td>
                            <td><span>@item.Timestamp</span></td>
                            <td><span>@item.Agent</span></td>
                            <td><span>@item.Project</span></td>
                            <td><span>@item.Domain</span></td>
                            <td><span>@item.RelativeUrl</span></td>
                            <td><span>@item.ResponseCode</span></td>
                        </tr>
                    </RowTemplate>
                </RowGenerator>
            }
        </table>
        </div>
    </div>
</div>

@code {

    private enum HeartbeatsSortedBy
    {
        None,
        IdAsc,
        IdDsc,
        TimestampAsc,
        TimestampDsc,
        AgentAsc,
        AgentDsc,
        ProjectAsc,
        ProjectDsc,
        DomainAsc,
        DomainDsc,
        RelativeUrlAsc,
        RelativeUrlDsc,
        ResponseCodeAsc,
        ResponseCodeDsc
    }
    private HeartbeatsSortedBy HeartbeatDataSortedBy { get; set; } = HeartbeatsSortedBy.IdDsc;

    private static IOrderedEnumerable<HeartbeatData> SortHeartbeatsAscending<TResult>(
            IEnumerable<HeartbeatData> heartbeats,
            Func<HeartbeatData, TResult> keySelector)
    {
        return heartbeats.OrderBy(keySelector);
    }

    private static IOrderedEnumerable<HeartbeatData> SortHeartbeatsDescending<TResult>(
    IEnumerable<HeartbeatData> heartbeats,
    Func<HeartbeatData, TResult> keySelector)
    {
        return heartbeats.OrderByDescending(keySelector);
    }

    private IEnumerable<HeartbeatData> SortVisibleHeartbeats(IEnumerable<HeartbeatData> heartbeats)
    {
         return HeartbeatDataSortedBy switch {
                       HeartbeatsSortedBy.IdAsc => SortHeartbeatsAscending(heartbeats, x => x.Id),
                       HeartbeatsSortedBy.IdDsc => SortHeartbeatsDescending(heartbeats, x => x.Id),

                       HeartbeatsSortedBy.TimestampAsc => SortHeartbeatsAscending(heartbeats, x => x.Timestamp),
                       HeartbeatsSortedBy.TimestampDsc => SortHeartbeatsDescending(heartbeats, x => x.Timestamp),

                       HeartbeatsSortedBy.AgentAsc => SortHeartbeatsAscending(heartbeats, x => x.Agent),
                       HeartbeatsSortedBy.AgentDsc => SortHeartbeatsDescending(heartbeats, x => x.Agent),

                       HeartbeatsSortedBy.ProjectAsc => SortHeartbeatsAscending(heartbeats, x => x.Project),
                       HeartbeatsSortedBy.ProjectDsc => SortHeartbeatsDescending(heartbeats, x => x.Project),

                       HeartbeatsSortedBy.DomainAsc => SortHeartbeatsAscending(heartbeats, x => x.Domain),
                       HeartbeatsSortedBy.DomainDsc => SortHeartbeatsDescending(heartbeats, x => x.Domain),

                       HeartbeatsSortedBy.RelativeUrlAsc => SortHeartbeatsAscending(heartbeats, x => x.RelativeUrl),
                       HeartbeatsSortedBy.RelativeUrlDsc => SortHeartbeatsDescending(heartbeats, x => x.RelativeUrl),

                       HeartbeatsSortedBy.ResponseCodeAsc => SortHeartbeatsAscending(heartbeats, x => x.ResponseCode),
                       HeartbeatsSortedBy.ResponseCodeDsc => SortHeartbeatsDescending(heartbeats, x => x.ResponseCode),

                       _ => heartbeats
               };
    }

    private void SortHeartbeatTableById(Func<HeartbeatData, long> sortedBy)
    {
        if (HeartbeatDataSortedBy.CompareTo(HeartbeatsSortedBy.IdAsc) != 0)
        {
            Heartbeats = SortHeartbeatsAscending(Heartbeats, sortedBy);
            HeartbeatDataSortedBy = HeartbeatsSortedBy.IdAsc;
        }
        else
        {
            Heartbeats = SortHeartbeatsDescending(Heartbeats, sortedBy);
            HeartbeatDataSortedBy = HeartbeatsSortedBy.IdDsc;
        }
    }

    private void SortHeartbeatTableByTimestamp(Func<HeartbeatData, DateTime> sortedBy)
    {
        if (HeartbeatDataSortedBy.CompareTo(HeartbeatsSortedBy.TimestampAsc) != 0)
        {
            Heartbeats = SortHeartbeatsAscending(Heartbeats, sortedBy);
            HeartbeatDataSortedBy = HeartbeatsSortedBy.TimestampAsc;
        }
        else
        {
            Heartbeats = SortHeartbeatsDescending(Heartbeats, sortedBy);
            HeartbeatDataSortedBy = HeartbeatsSortedBy.TimestampDsc;
        }
    }

    private void SortHeartbeatTableByAgent(Func<HeartbeatData, string> sortedBy)
    {
        if (HeartbeatDataSortedBy.CompareTo(HeartbeatsSortedBy.AgentAsc) != 0)
        {
            Heartbeats = SortHeartbeatsAscending(Heartbeats, sortedBy);
            HeartbeatDataSortedBy = HeartbeatsSortedBy.AgentAsc;
        }
        else
        {
            Heartbeats = SortHeartbeatsDescending(Heartbeats, sortedBy);
            HeartbeatDataSortedBy = HeartbeatsSortedBy.AgentDsc;
        }
    }

    private void SortHeartbeatTableByProject(Func<HeartbeatData, string> sortedBy)
    {
        if (HeartbeatDataSortedBy.CompareTo(HeartbeatsSortedBy.ProjectAsc) != 0)
        {
            Heartbeats = SortHeartbeatsAscending(Heartbeats, sortedBy);
            HeartbeatDataSortedBy = HeartbeatsSortedBy.ProjectAsc;
        }
        else
        {
            Heartbeats = SortHeartbeatsDescending(Heartbeats, sortedBy);
            HeartbeatDataSortedBy = HeartbeatsSortedBy.ProjectDsc;
        }
    }

    private void SortHeartbeatTableByDomain(Func<HeartbeatData, string> sortedBy)
    {
        if (HeartbeatDataSortedBy.CompareTo(HeartbeatsSortedBy.DomainAsc) != 0)
        {
            Heartbeats = SortHeartbeatsAscending(Heartbeats, sortedBy);
            HeartbeatDataSortedBy = HeartbeatsSortedBy.DomainAsc;
        }
        else
        {
            Heartbeats = SortHeartbeatsDescending(Heartbeats, sortedBy);
            HeartbeatDataSortedBy = HeartbeatsSortedBy.DomainDsc;
        }
    }

    private void SortHeartbeatTableByRelativeUrl(Func<HeartbeatData, string> sortedBy)
    {
        if (HeartbeatDataSortedBy.CompareTo(HeartbeatsSortedBy.RelativeUrlAsc) != 0)
        {
            Heartbeats = SortHeartbeatsAscending(Heartbeats, sortedBy);
            HeartbeatDataSortedBy = HeartbeatsSortedBy.RelativeUrlAsc;
        }
        else
        {
            Heartbeats = SortHeartbeatsDescending(Heartbeats, sortedBy);
            HeartbeatDataSortedBy = HeartbeatsSortedBy.RelativeUrlDsc;
        }
    }

    private void SortHeartbeatTableByResponseCode(Func<HeartbeatData, string> sortedBy)
    {
        if (HeartbeatDataSortedBy.CompareTo(HeartbeatsSortedBy.ResponseCodeAsc) != 0)
        {
            Heartbeats = SortHeartbeatsAscending(Heartbeats, sortedBy);
            HeartbeatDataSortedBy = HeartbeatsSortedBy.ResponseCodeAsc;
        }
        else
        {
            Heartbeats = SortHeartbeatsDescending(Heartbeats, sortedBy);
            HeartbeatDataSortedBy = HeartbeatsSortedBy.ResponseCodeDsc;
        }
    }
}
